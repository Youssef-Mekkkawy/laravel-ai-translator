{
  "name": "youssef-mekkkawy/laravel-ai-translator",
  "description": "AI-powered automatic translation for Laravel applications. Scan views, detect keys, and translate to multiple languages using DeepL, OpenAI, or Claude.",
  "keywords": [
    "laravel",
    "translation",
    "i18n",
    "localization",
    "ai",
    "deepl",
    "openai",
    "claude",
    "multi-language"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Youssef Mekkkawy",
      "email": "your-email@example.com",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/Youssef-Mekkkawy/laravel-ai-translator",
  "support": {
    "issues": "https://github.com/Youssef-Mekkkawy/laravel-ai-translator/issues",
    "source": "https://github.com/Youssef-Mekkkawy/laravel-ai-translator"
  },
  "require": {
    "php": "^8.4",
    "illuminate/support": "^10.0|^11.0",
    "illuminate/console": "^10.0|^11.0",
    "illuminate/filesystem": "^10.0|^11.0",
    "guzzlehttp/guzzle": "^7.8",
    "deeplcom/deepl-php": "^1.18",
    "nesbot/carbon": "^3.11"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0",
    "pestphp/pest": "^2.0",
    "pestphp/pest-plugin-laravel": "^2.0",
    "phpstan/phpstan": "^1.10",
    "laravel/pint": "^1.0",
    "larastan/larastan": "^2.11"
  },
  "autoload": {
    "psr-4": {
      "YoussefMekkkawy\\LaravelAiTranslator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "YoussefMekkkawy\\LaravelAiTranslator\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/pest --coverage",
    "format": "vendor/bin/pint",
    "analyse": "vendor/bin/phpstan analyse"
  },
  "extra": {
    "laravel": {
      "providers": [
        "YoussefMekkkawy\\LaravelAiTranslator\\LaravelAiTranslatorServiceProvider"
      ],
      "aliases": {
        "AITranslator": "YoussefMekkkawy\\LaravelAiTranslator\\Facades\\AITranslator"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    },
    "platform": {
      "php": "8.4.24"
    }
  }
}
