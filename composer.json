{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "youssef-mekkkawy/laravel-ai-translator",
    "description": "AI-powered automatic translation for Laravel — scan Blade views, translate to any language using Ollama, DeepL, Claude, ChatGPT or Gemini, with smart change tracking, lock system, backup/restore, and an embedded dashboard.",
    "keywords": [
        "laravel",
        "laravel-package",
        "translation",
        "localization",
        "i18n",
        "multi-language",
        "ai",
        "ollama",
        "deepl",
        "openai",
        "claude",
        "developer-tools",
        "open-source"
    ],
    "version": "1.0.10",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/Youssef-Mekkkawy/laravel-ai-translator",
    "authors": [
        {
            "name": "Youssef Mekkkawy",
            "email": "31347791+Youssef-Mekkkawy@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Youssef-Mekkkawy/laravel-ai-translator/issues",
        "source": "https://github.com/Youssef-Mekkkawy/laravel-ai-translator"
    },
    "funding": [
        {
            "type": "custom",
            "url": "https://buymeacoffee.com/youssef.mekkawy"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.8",
        "deeplcom/deepl-php": "^1.7",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.0|^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^7.0|^8.8",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^1.10|^2.0",
        "phpstan/phpstan-deprecation-rules": "^1.0|^2.0",
        "phpstan/phpstan-phpunit": "^1.0|^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "YoussefMekkkawy\\LaravelAiTranslator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YoussefMekkkawy\\LaravelAiTranslator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "format-test": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    },
    "extra": {
        "laravel": {
            "providers": [
                "YoussefMekkkawy\\LaravelAiTranslator\\LaravelAiTranslatorServiceProvider"
            ],
            "aliases": {
                "AITranslator": "YoussefMekkkawy\\LaravelAiTranslator\\Facades\\AITranslator"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "ignore": {
                "PKSA-m5cs-t1y6-qpcs": "Package does not use signed URLs",
                "PKSA-3r5d-mb8f-1qw9": "Package does not use email validation",
                "PKSA-mdq4-51ck-6kdq": "Same root cause as PKSA-3r5d-mb8f-1qw9",
                "PKSA-8qx3-n5y5-vvnd": "Package does not handle file uploads",
                "PKSA-q46n-4fdk-zjr4": "XSS on debug error page - not applicable",
                "PKSA-qzrn-rnz3-85w1": "XSS on debug error page - not applicable",
                "PKSA-w7xr-vk7n-rstm": "Package does not read env from request"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}



